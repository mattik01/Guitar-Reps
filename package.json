{
  "name": "guitar-reps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:chords": "esbuild scripts/checkChords.ts --bundle --platform=node --format=esm | node --input-type=module",
    "check:chroma": "esbuild scripts/checkChroma.ts --bundle --platform=node --format=esm | node --input-type=module",
    "check:profiles": "esbuild scripts/checkProfiles.ts --bundle --platform=node --format=esm | node --input-type=module",
    "check:roadmap": "esbuild scripts/checkRoadmap.ts --bundle --platform=node --format=esm | node --input-type=module",
    "check:songs": "esbuild scripts/checkSongs.ts --bundle --platform=node --format=esm | node --input-type=module",
    "check:normalize": "esbuild scripts/checkNormalize.ts --bundle --platform=node --format=esm | node --input-type=module",
    "check:chordonomicon": "esbuild scripts/checkChordonomicon.ts --bundle --platform=node --format=esm | node --input-type=module",
    "check:youtube-import": "esbuild scripts/checkYoutubeImport.ts --bundle --platform=node --format=esm --external:better-sqlite3 --outfile=.check-yt.mjs && node .check-yt.mjs",
    "enrich:spotify": "esbuild scripts/enrichSpotify.ts --bundle --platform=node --format=esm | node --input-type=module",
    "build:catalog": "esbuild scripts/buildCatalog.ts --bundle --platform=node --format=esm --external:better-sqlite3 | node --input-type=module",
    "stats:transitions": "esbuild scripts/transitionStats.ts --bundle --platform=node --format=esm --external:better-sqlite3 --outfile=.stats-transitions.mjs && node .stats-transitions.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^7.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
